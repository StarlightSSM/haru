{
  "name": "haru-atelier",
  "productName": "HARU",
  "version": "1.0.0",
  "description": "매일 세상을 듣고 음악과 그림을 만드는 나만의 아틀리에 펫",
  "main": "main.js",
  "author": "sumin",
  "license": "Apache-2.0",
  "scripts": {
    "build:3d": "node tools/build-3d.js",
    "start": "node tools/build-3d.js && electron .",
    "fast": "node tools/build-3d.js && electron . --fast",
    "icon": "electron tools/make-icon.js",
    "dist": "node tools/build-3d.js && electron-builder --win nsis",
    "mobile:web": "node tools/build-web.js",
    "android": "powershell -ExecutionPolicy Bypass -File tools/build-android.ps1",
    "android:release": "powershell -ExecutionPolicy Bypass -File tools/build-android.ps1 -Release",
    "ios": "node tools/build-web.js && npx cap sync ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "lamejs": "1.2.1",
    "mp4-muxer": "5.2.2"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.187.0",
    "@capacitor/cli": "^8.6.0",
    "electron": "38.4.0",
    "electron-builder": "26.0.12",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.sumin.haru",
    "productName": "HARU",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/node_modules/@capacitor/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HARU",
      "runAfterFinish": true
    }
  }
}
